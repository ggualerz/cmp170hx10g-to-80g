{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "02_static-ga100-hbm-state_registers.schema.json",
  "title": "GA100 HBM register observation row",
  "description": "Schema for each row in 02_static-ga100-hbm-state_registers.csv. The CSV is observation-normalized: one register/state/value/source claim per row, so conflicts remain visible instead of being overwritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_name",
    "address",
    "address_space",
    "functional_block",
    "scope",
    "fields",
    "access",
    "privilege_or_plm",
    "persistence",
    "initialization_stage",
    "known_writer",
    "known_reader",
    "activity",
    "classification",
    "device_sku",
    "hbm_vendor",
    "state",
    "value",
    "source_locator",
    "confidence",
    "notes"
  ],
  "properties": {
    "canonical_name": {"type": "string", "minLength": 1},
    "address": {"type": "string", "pattern": "^(0x[0-9A-Fa-f]+( \\+ n\\*0x[0-9A-Fa-f]+)?|unknown|symbolic)$"},
    "address_space": {"type": "string", "enum": ["BAR0", "HBM IEEE1500", "MODS binary", "unknown"]},
    "functional_block": {"type": "string", "enum": ["geometry", "timing", "refresh", "mode-register", "training", "identity", "privilege", "ieee1500"]},
    "scope": {"type": "string", "enum": ["broadcast", "per-FBPA", "per-subpartition", "per-byte", "per-die", "range", "unknown"]},
    "fields": {"type": "string"},
    "access": {"type": "string", "enum": ["RO", "RW", "WO", "derived", "unknown"]},
    "privilege_or_plm": {"type": "string"},
    "persistence": {"type": "string", "enum": ["until-FLR", "boot-latched", "runtime", "unknown"]},
    "initialization_stage": {"type": "string", "enum": ["devinit", "FBFLCN-training", "driver-runtime", "HS-refire", "hardware-derived", "unknown"]},
    "known_writer": {"type": "string"},
    "known_reader": {"type": "string"},
    "activity": {"type": "string", "enum": ["active", "inactive", "status-only", "identity-only", "unknown"]},
    "classification": {"type": "string", "enum": ["confirmed", "inferred", "open", "closed-negative", "conflict"]},
    "device_sku": {"type": "string"},
    "hbm_vendor": {"type": "string"},
    "state": {"type": "string"},
    "value": {"type": "string"},
    "source_locator": {"type": "string", "minLength": 1},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "notes": {"type": "string"}
  }
}
